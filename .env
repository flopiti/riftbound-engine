# Copy this file to .env and adjust as needed.
FAKE_FILL=true

# The database the app uses. Point this at your winterfell Postgres.
#   - engine running ON winterfell:        host=localhost port=5432
#   - engine on your Mac via SSH tunnel:   host=localhost port=5433
DATABASE_URL=postgresql://riftbound:changeme@192.168.0.10:5432/riftbound


